# Database
DATABASE_URL="postgresql://vendorflow:vendorflow_dev_password@localhost:5432/vendorflow?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="1h"

# Gemini AI Configuration
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_PROJECT_ID="your-gcp-project-id"
GEMINI_LOCATION="us-central1"

# Application
NODE_ENV="development"
PORT=3001

# CORS Configuration (at least one required in production)
# Main production URL
FRONTEND_URL="http://localhost:3000"
# Optional: Staging environment URL
FRONTEND_URL_STAGING=""
# Optional: Preview/test environment URL
FRONTEND_URL_PREVIEW=""

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
